{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // 记住用户选过的备份目录授权，重启后仍能直接往里写（fileshare.persistPermission）。
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        // 生物识别快捷解锁：@ohos.userIAM.userAuth 的人脸/指纹验证（批5）。
        "name": "ohos.permission.ACCESS_BIOMETRIC",
        "reason": "$string:biometric_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // 朗读后台续播：批7 长时任务 AUDIO_PLAYBACK。normal/system_grant，无需运行时申请。
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_desc",
        "icon": "$media:layered_image",
        "label": "$string:entry_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 批7：允许 AUDIO_PLAYBACK 长时任务，朗读切后台后继续出声。
        // 第十表 F-12：加 dataTransfer，导出书籍走 DATA_TRANSFER 长时任务
        // （对齐上游 `ExportBookService` 前台 Service，见 `data/ExportBackgroundTask.ets`）。
        "backgroundModes": ["audioPlayback", "dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ]
  }
}
