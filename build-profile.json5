{
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    },
    {
      "name": "sourceengine",
      "srcPath": "./third_party/harmony-book-source-engine/sourceengine"
    },
    {
      "name": "quickjs",
      "srcPath": "./third_party/harmony-book-source-engine/quickjs"
    }
  ]
}
